# EasyOPD local configuration — copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed. This template is safe to publish.

# Sandbox Fusion service endpoint used by SOD/agentic rollout + code evaluation.
# Provide your own sandbox service URL (e.g. a self-hosted sandbox-fusion or a
# managed endpoint). Leave unset to fall back to the in-script placeholder.
SANDBOX_FUSION_URL="https://YOUR_SANDBOX_FUSION_ENDPOINT/run_code"

# Optional: Weights & Biases API key for experiment logging (trainer.logger includes "wandb").
# WANDB_API_KEY=

# Optional: local model / dataset roots referenced by the example launch scripts.
# EASYOPD_ROOT=/path/to/EasyOPD
# MODELS_ROOT=/path/to/models
